{
  "name": "dsh-plugin-xiaowu",
  "version": "0.1.2",
  "description": "小舞 · DSH 桌宠：常驻 Web 界面右下角的兔耳少女桌面宠物，跟随 agent 工作状态换动作，任务完成时用运行时合成的甜声说一句「做完啦……」。形象为原创 SVG 手绘，声音为 WebAudio 实时合成。",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "desktop-pet",
    "xiaowu",
    "web-audio"
  ],
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "cordis.patch.yml",
    "install.mjs",
    "uninstall.mjs",
    "README.md",
    "LICENSE",
    "preview.html"
  ],
  "scripts": {
    "test": "node test/harness.cjs",
    "test:dom": "node test/dom.cjs",
    "preview": "node test/preview.cjs",
    "install-plugin": "node install.mjs",
    "uninstall-plugin": "node uninstall.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "jsdom": "^24.1.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jxboop/dsh-plugin-xiaowu.git"
  },
  "homepage": "https://github.com/jxboop/dsh-plugin-xiaowu#readme",
  "bugs": {
    "url": "https://github.com/jxboop/dsh-plugin-xiaowu/issues"
  },
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.2"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-session"
      ]
    }
  }
}
